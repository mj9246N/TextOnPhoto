<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEEEEE">

    <FrameLayout
        android:id="@+id/canvasContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/buttonPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintDimensionRatio="16:9">

        <com.example.textonphoto.CanvasView
            android:id="@+id/canvasView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/white" />

    </FrameLayout>

    <!-- پنل دکمه‌ها -->
    <LinearLayout
        android:id="@+id/buttonPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="4dp"
        android:background="#FAFAFA"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ردیف ۱: افزودن، ویرایش، کپی، حذف -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="2dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddText"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:text="متن جدید" android:textSize="13sp" android:layout_marginHorizontal="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:text="✏️" android:textSize="13sp" android:layout_marginHorizontal="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopy"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:text="کپی" android:textSize="13sp" android:layout_marginHorizontal="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:text="حذف" android:textSize="13sp" android:layout_marginHorizontal="1dp" />
        </LinearLayout>

        <!-- ردیف ۲: فونت، رنگ، استایل -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="2dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFont"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:text="فونت" android:textSize="13sp" android:layout_marginHorizontal="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnColor"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:text="رنگ" android:textSize="13sp" android:layout_marginHorizontal="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStyle"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:text="زیرخط" android:textSize="13sp" android:layout_marginHorizontal="1dp" />
        </LinearLayout>

        <!-- ردیف ۳: چرخش و اندازه -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="2dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRotateLeft"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="44dp" android:layout_height="44dp"
                android:text="↺" android:textSize="18sp"
                android:layout_marginEnd="2dp" app:cornerRadius="22dp" />

            <TextView
                android:id="@+id/tvRotation"
                android:layout_width="wrap_content" android:layout_height="44dp"
                android:gravity="center" android:minWidth="40dp"
                android:text="0°" android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRotateRight"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="44dp" android:layout_height="44dp"
                android:text="↻" android:textSize="18sp"
                android:layout_marginStart="2dp" app:cornerRadius="22dp" />

            <View android:layout_width="8dp" android:layout_height="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZoomOut"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="44dp" android:layout_height="44dp"
                android:text="−" android:textSize="18sp"
                android:layout_marginEnd="2dp" app:cornerRadius="22dp" />

            <TextView
                android:id="@+id/tvSize"
                android:layout_width="wrap_content" android:layout_height="44dp"
                android:gravity="center" android:minWidth="40dp"
                android:text="60" android:textSize="14sp" android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZoomIn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="44dp" android:layout_height="44dp"
                android:text="+" android:textSize="18sp"
                android:layout_marginStart="2dp" app:cornerRadius="22dp" />
        </LinearLayout>

        <!-- ردیف ۴: برچسب، قفل، برگشت، ذخیره -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="2dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSticker"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:text="برچسب" android:textSize="13sp" android:layout_marginHorizontal="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLock"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:text="قفل" android:textSize="13sp" android:layout_marginHorizontal="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUndo"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:text="↩️" android:textSize="13sp" android:layout_marginHorizontal="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:text="ذخیره" android:textSize="13sp" android:layout_marginHorizontal="1dp" />
        </LinearLayout>

        <!-- ردیف ۵: فقط تاریخچه -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="2dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHistory"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:text="تاریخچه" android:textSize="12sp" android:layout_marginHorizontal="1dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
