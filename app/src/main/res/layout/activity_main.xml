<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEEEEE">

    <FrameLayout
        android:id="@+id/canvasContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/buttonPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5"
        app:layout_constraintDimensionRatio="16:9">

        <com.example.textonphoto.CanvasView
            android:id="@+id/canvasView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/white" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/buttonPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="4dp"
        android:background="#FAFAFA"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- ردیف ۱: افزودن، ویرایش، کپی، حذف -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="2dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddText"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="متن جدید" android:textSize="14sp" android:layout_marginHorizontal="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="✏️" android:textSize="14sp" android:layout_marginHorizontal="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopy"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="کپی" android:textSize="14sp" android:layout_marginHorizontal="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="حذف" android:textSize="14sp" android:layout_marginHorizontal="1dp" />
        </LinearLayout>

        <!-- ردیف ۲: رنگ، زیرخط، تراز -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="2dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnColor"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="رنگ" android:textSize="14sp" android:layout_marginHorizontal="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStyle"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="زیرخط" android:textSize="14sp" android:layout_marginHorizontal="1dp" />

            <!-- دکمه‌های تراز با استایل مشابه -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAlignLeft"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="48dp" android:layout_height="48dp"
                android:text="L" android:textSize="18sp" android:layout_marginHorizontal="1dp"
                app:cornerRadius="24dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAlignCenter"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="48dp" android:layout_height="48dp"
                android:text="C" android:textSize="18sp" android:layout_marginHorizontal="1dp"
                app:cornerRadius="24dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAlignRight"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="48dp" android:layout_height="48dp"
                android:text="R" android:textSize="18sp" android:layout_marginHorizontal="1dp"
                app:cornerRadius="24dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" />
        </LinearLayout>

        <!-- ردیف ۳: چرخش و اندازه (دکمه‌های گرد کامل) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="2dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRotateLeft"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="48dp" android:layout_height="48dp"
                android:text="↖️" android:textSize="22sp"
                android:layout_marginEnd="2dp"
                app:cornerRadius="24dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" />

            <TextView
                android:id="@+id/tvRotation"
                android:layout_width="wrap_content" android:layout_height="48dp"
                android:gravity="center" android:minWidth="48dp"
                android:text="0°" android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRotateRight"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="48dp" android:layout_height="48dp"
                android:text="↗️" android:textSize="22sp"
                android:layout_marginStart="2dp"
                app:cornerRadius="24dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" />

            <View android:layout_width="8dp" android:layout_height="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZoomOut"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="48dp" android:layout_height="48dp"
                android:text="🔙" android:textSize="22sp"
                android:layout_marginEnd="2dp"
                app:cornerRadius="24dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" />

            <TextView
                android:id="@+id/tvSize"
                android:layout_width="wrap_content" android:layout_height="48dp"
                android:gravity="center" android:minWidth="48dp"
                android:text="60" android:textSize="16sp" android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnZoomIn"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="48dp" android:layout_height="48dp"
                android:text="🔝" android:textSize="22sp"
                android:layout_marginStart="2dp"
                app:cornerRadius="24dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" />
        </LinearLayout>

        <!-- ردیف ۴: برچسب، قفل، برگشت، ذخیره -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="2dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSticker"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="برچسب" android:textSize="14sp" android:layout_marginHorizontal="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLock"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="قفل" android:textSize="14sp" android:layout_marginHorizontal="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUndo"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="↩️" android:textSize="14sp" android:layout_marginHorizontal="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="ذخیره" android:textSize="14sp" android:layout_marginHorizontal="1dp" />
        </LinearLayout>

        <!-- ردیف ۵: تاریخچه و لایه‌های متن -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="2dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHistory"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="تاریخچه" android:textSize="14sp" android:layout_marginHorizontal="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTextLayers"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="لایه‌های متن" android:textSize="14sp" android:layout_marginHorizontal="1dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
